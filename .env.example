# Password for the single-user login (required in production).
APP_PASSWORD=change-me

# Optional: separate secret used to sign the login cookie. Defaults to APP_PASSWORD.
# Changing it (or the password) logs out all devices.
AUTH_SECRET=

# Postgres connection string (Neon). Set automatically by the Vercel ↔ Neon integration.
# Leave empty locally to use an embedded PGlite database stored in ./.pglite
DATABASE_URL=

# Fallback timezone for "today" before the browser reports its own (IANA name).
TZ_DEFAULT=Europe/Berlin
