# Invite code required to create an account (also lets you create the first one).
# Without it, only the very first account can be created.
APP_PASSWORD=change-me

# Long random secret for signing sessions (required in production). Generate one with:
#   openssl rand -base64 32
BETTER_AUTH_SECRET=

# Public URL of the app, e.g. https://lift-log.vercel.app (optional on Vercel; inferred otherwise).
BETTER_AUTH_URL=

# Postgres connection string (Neon). Set automatically by the Vercel ↔ Neon integration.
# Leave empty locally to use an embedded PGlite database stored in ./.pglite
DATABASE_URL=

# Fallback timezone for "today" before the browser reports its own (IANA name).
TZ_DEFAULT=Europe/Berlin
